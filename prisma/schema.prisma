// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // for local development
  // url      = env("DATABASE_URL")
  // for Vercel
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

enum Role {
  USER
  ADMIN
}

model User {
  id            Int            @id @default(autoincrement())
  email         String         @unique
  password      String
  role          Role           @default(USER)
  userName      String?
  description   String?
  points        Int            @default(0)
  profileImage  String?
  courses       CourseToUser[]
  sessions      Session[]
}

model Course {
  id                Int            @id @default(autoincrement())
  courseName        String         @unique
  courseTitle       String
  users             CourseToUser[]
  sessions          Session[]
}

model CourseToUser {
  userId   Int
  user     User   @relation(fields: [userId], references: [id])
  courseId Int
  course   Course @relation(fields: [courseId], references: [id])

  @@id([userId, courseId])
}

enum Condition {
  excellent
  good
  fair
  poor
}

model Stuff {
  id        Int       @id @default(autoincrement())
  name      String
  quantity  Int
  condition Condition @default(good)
  owner     String
}

model Session {
  id          Int       @id @default(autoincrement())
  name        String
  courseId    Int
  course      Course    @relation(fields: [courseId], references: [id])
  location    String
  description String?
  startDate   DateTime
  endDate     DateTime
  userId      Int
  user        User      @relation(fields: [userId], references: [id])
  owner       String

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
  @@index([courseId])
  @@index([startDate])
}
