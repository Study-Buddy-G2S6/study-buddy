// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "sqlite"
  url       = "file:./dev.db"
}

enum Role {
  USER
  ADMIN
}

model User {
  id            Int            @id @default(autoincrement())
  email         String         @unique
  password      String
  role          Role           @default(USER)
  userName      String?
  description   String?
  points        Int            @default(0)
  profileImage  String?
  courseToUsers CourseToUser[]
  sessions      Session[]
}

model Course {
  id                Int            @id @default(autoincrement())
  courseName        String
  courseTitle       String
  courseToUsers     CourseToUser[]
  sessions          Session[]
}

model CourseToUser {
  id       Int    @id @default(autoincrement())
  userId   Int
  user     User   @relation(fields: [userId], references: [id])
  courseId Int
  course   Course @relation(fields: [courseId], references: [id])

  // Ensure a user cannot be enrolled in the same course more than once.
  @@unique([userId, courseId])
}

enum Condition {
  excellent
  good
  fair
  poor
}

model Stuff {
  id        Int       @id @default(autoincrement())
  name      String
  quantity  Int
  condition Condition @default(good)
  owner     String
}

model Session {
  id                Int             @id @default(autoincrement())
  name              String
  description       String
  userId            Int
  user              User            @relation(fields: [userId], references: [id])
  courseId  Int
  course    Course  @relation(fields: [courseId], references: [id])
  startDate         DateTime
  endDate           DateTime
  owner             String
}
